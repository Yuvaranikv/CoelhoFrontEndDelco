<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TURN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- SB Admin Template Styles -->
   
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/templates/sb-admin/css/styles.css" rel="stylesheet" />
    <style>
        .navbar-brand img {
            height: 50px;
        }

        #layoutSidenav_nav .sidebar {
            background-color: seagreen !important;
            color: white;
        }

            .sidebar .nav-link {
                color: rgba(255, 255, 255, 0.7);
            }

                .sidebar .nav-link.active {
                    color: white;
                }

        .content-wrapper {
            min-height: 100vh;
            padding: 20px;
        }

        .input-group-append .input-group-text {
            margin-left: 10px;
            border-left: none; /* Adjust spacing as needed */
        }

         
  </style>
</head>

<body class="sb-nav-fixed">
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand ps-3" href="#">
            <img src="~/images/turnlogo2.png" alt="Logo" class="rounded-circle">
            
        </a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#"><i class="fas fa-bars"></i></button>

        <form class="d-flex align-items-center ms-auto me-0 me-md-3 my-2 my-md-0">
            <div class="input-group">
                <input class="form-control" type="text" placeholder="Search..." aria-label="Search" aria-describedby="btnNavbarSearch" />
                <button class="btn btn-primary" id="btnNavbarSearch" type="button"><i class="fas fa-search"></i></button>
            </div>
            <div class="d-flex ms-3">
                <span class="input-group-text bg-transparent border-0 px-2" data-bs-toggle="tooltip" title="Add Family Member" style="cursor: pointer;">
                    <i class="fa-solid fa-user-plus text-light"></i>
                </span>
                <span class="input-group-text bg-transparent border-0 px-2" data-bs-toggle="tooltip" title="Family Members" style="cursor: pointer;">
                    <i class="fa-solid fa-users text-light"></i>
                </span>
                <span class="input-group-text bg-transparent border-0 px-2" data-bs-toggle="tooltip" title="Clear" style="cursor: pointer;">
                    <i class="fa-solid fa-x text-light"></i>
                </span>
                <span class="input-group-text bg-transparent border-0 px-2" data-bs-toggle="tooltip" title="New Member" style="cursor: pointer;">
                    <i class="fa-solid fa-plus text-light"></i>
                </span>
            </div>

        </form>


        <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" id="userDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-user fa-fw"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="#">Profile</a></li>
                    <li><a class="dropdown-item" href="#">Settings</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Logout">Logout</a></li>
                </ul>
            </li>
        </ul>
    </nav>

    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                       @*  <div class="sb-sidenav-menu-heading">Turn</div> *@
                        <a class="nav-link" asp-area="" asp-page="/Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-home"></i></div>
                            Home
                        </a>
                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                            Dashboard
                        </a>

                        <div class="sb-sidenav-menu-heading">Client Management</div>
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseClientManagement" aria-expanded="false" aria-controls="collapseClientManagement">
                            <div class="sb-nav-link-icon"><i class="fas fa-users"></i></div>
                            Manage Clients
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseClientManagement" aria-labelledby="headingOne" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" asp-area="" asp-page="/ClientManagement/ClientMaster">Manage Clients</a>
                                <a class="nav-link" asp-area="" asp-page="/ClientManagement/ViewClientMaster">View Clients</a>
                            </nav>
                        </div>

                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseClientRecord" aria-expanded="false" aria-controls="collapseClientRecord">
                            <div class="sb-nav-link-icon"><i class="fas fa-folder"></i></div>
                            Client Record
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseClientRecord" aria-labelledby="headingTwo" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" asp-area="" asp-page="/ClientRecord/SubPage1">View Records</a>
                                <a class="nav-link" asp-area="" asp-page="/ClientRecord/SubPage2">Edit Records</a>
                            </nav>
                        </div>

                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseHousingAdmin" aria-expanded="false" aria-controls="collapseHousingAdmin">
                            <div class="sb-nav-link-icon"><i class="fas fa-building"></i></div>
                            Housing Admin
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseHousingAdmin" aria-labelledby="headingThree" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" asp-area="" asp-page="/HousingAdmin/SubPage1">Manage Housing</a>
                                <a class="nav-link" asp-area="" asp-page="/HousingAdmin/SubPage2">Housing Reports</a>
                            </nav>
                        </div>

                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseCaseManagement" aria-expanded="false" aria-controls="collapseCaseManagement">
                            <div class="sb-nav-link-icon"><i class="fas fa-briefcase"></i></div>
                            Case Management
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseCaseManagement" aria-labelledby="headingFour" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" asp-area="" asp-page="/CaseManagement/SubPage1">Manage Cases</a>
                                <a class="nav-link" asp-area="" asp-page="/CaseManagement/SubPage2">Case Reports</a>
                            </nav>
                        </div>
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Logged in as:</div>
                    Admin
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                  @*   <h1 class="mt-4">Dashboard</h1> *@
                    @RenderBody()
                </div>
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">&copy; @DateTime.Now.Year Coelho Consulting Inc., all rights reserved</div>
                        <div>
                            <a asp-area="" asp-page="/Privacy">Privacy Policy</a>
                            &middot;
                            <a href="#">Terms &amp; Conditions</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/templates/sb-admin/js/scripts.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
