@{
}

<style>
    /* General adjustments for neatness and responsive form */
    .form-control {
        max-width: 300px; /* Reduce width for neat appearance */
        margin-left: auto;
        margin-right: auto;
        display: block; /* Center the inputs */
        padding: 0.8rem 1rem;
    }

    .mb-3 {
        margin-bottom: 1.25rem; /* Slightly increased margin between form fields */
    }

    /* Adjust label alignment */
    .col-form-label {
        text-align: left;
    }

    /* Adjust the width of the family size input */
    #FamilySize {
        width: 100%; /* Ensure the input takes full width */
    }

    /* Adjust spacing between form controls */
    .form-check-inline {
        margin-right: 20px; /* Provide spacing between radio buttons */
    }

        /* Adjust input widths in the Family Type section */
        .form-check-inline input {
            margin-right: 8px; /* Space between radio buttons and labels */
        }

    /* Visibility control for family size section */
    #familySizeRow {
        visibility: hidden; /* Hidden by default, will be toggled based on radio button */
    }
</style>

<div class="container mt-8 form-container">
    <h2 class="highlight-header mt-4">Intake Form</h2>

    <div class="mb-3 row">
        <label for="IntakeDate" class="col-sm-4 col-form-label required">Intake Date</label>
        <div class="col-sm-6 col-md-4">
            <input type="text" name="IntakeDate" class="form-control" id="IntakeDate" placeholder="MM/DD/YYYY" required pattern="\d{2}/\d{2}/\d{4}">
        </div>
    </div>

    <div class="mb-3 row">
        <label for="CreatedBy" class="col-sm-4 col-form-label">Created By</label>
        <div class="col-sm-6 col-md-4">
            <input type="text" name="CreatedBy" class="form-control" id="CreatedBy" value="Administrator System" readonly>
        </div>
    </div>

    <!-- Family Type Section -->
    <div class="mb-3 row">
        <label for="familyType" class="col-sm-4 col-form-label required">Family Type</label>
        <div class="col-sm-6 col-md-4">
            <div class="form-check form-check-inline" style="padding-left: 75px;">
                <input class="form-check-input" type="radio" name="familyType" id="single" value="Single" required onclick="toggleFamilySize(false)">
                <label class="form-check-label" for="single">Single</label>
            </div>
            <div class="form-check form-check-inline" style="padding-left: 75px;">
                <input class="form-check-input" type="radio" name="familyType" id="family" value="Family" required onclick="toggleFamilySize(true)">
                <label class="form-check-label" for="family">Family</label>
            </div>
        </div>
    </div>



    <!-- Family Size Section -->
    <div class="mb-3 row" id="familySizeRow" style="visibility: hidden;">
        <label for="FamilySize" class="col-sm-4 col-form-label">Family Size</label>
        <div class="col-sm-6 col-md-4">
            <input type="number" name="FamilySize" class="form-control" id="FamilySize" value="0" required>
        </div>
    </div>

</div>

<script>
	// Function to toggle the visibility of Family Size input
		function toggleFamilySize(isFamilySelected) {
		var familySizeRow = document.getElementById('familySizeRow');
		if (isFamilySelected) {
			familySizeRow.style.visibility = 'visible';  // Show Family Size input
		} else {
			familySizeRow.style.visibility = 'hidden';   // Hide Family Size input but maintain layout
		}
	}
</script>