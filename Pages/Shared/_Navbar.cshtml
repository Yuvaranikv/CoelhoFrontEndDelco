@{
	var userName = User.Identity.Name; // Get the logged-in user's name
}
<style>
	.dropdown-menu {
		z-index: 1050 !important;
	}

	.custom-navbar {
		background-color: cornflowerblue !important;
		padding: 15px 30px;
		/* border-radius: 15px; */
		/* background: linear-gradient(to right, #4e73df, #6a89cc); */ /* Smooth color flow */
		transition: all 0.3s ease-in-out;

	}

		/* Custom CSS for navbar links */
		.custom-navbar .nav-link {
			color: white !important;
			font-weight: 600;
			padding: 10px 15px;
			border-radius: 10px;
			transition: background 0.3s ease, color 0.3s ease;
		}

			/* Ensure the hover state also stays white */
			.custom-navbar .nav-link:hover {
				background-color: rgba(255, 255, 255, 0.2);
				color: lightgrey !important;
			}

	
		/* Dropdown Menu Styling */
		.custom-navbar .dropdown-menu {
			background-color: white;
		border-radius: 0; /* Remove rounded corners */
		box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
			padding: 10px;
			min-width: 220px;
		}

		/* Dropdown menu items */
		.custom-navbar .dropdown-item {
			color: black !important;
			font-weight: 500;
			padding: 10px 15px;
			border-radius: 5px;
			transition: background 0.3s ease;
		}

			/* Ensure the hover state also stays white */
			.custom-navbar .dropdown-item:hover {
				background-color: rgba(0, 0, 0, 0.05);
				color: darkblue;
			}

	

	

	

	

	/* Equal height button */
	.equal-btn {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	

	/* Adjusting the content to avoid overlap with the fixed navbar */
	/* .container {
			margin-top: 70px; /* Adjust based on the navbar height */

	/* Ensure that the sidebar content doesn't overflow or affect other elements */
	#page-content-wrapper {
		/* margin-left: 250px; */ /* Make space for the sidebar */
		padding: 20px;
		transition: margin-left 0.3s ease; /* Smooth transition when toggling sidebar */
	}

	.bg-custom {
		background-color: #4e73df; /* Custom dark blue */
	}

	/* .icon-circle {
		
		justify-content: center !important;
		align-items: center !important;
		width: 60px!important; 
		height: 30px!important;
		border-radius: 50% !important;
		background-color: royalblue;
		color: white;
		font-size: 20px;
		transition: background 0.3s ease, transform 0.2s ease;
	} */

	.icon-shape {
		width: 35px !important; /* Smaller square size */
		height: 35px !important;
		font-size: 16px !important; /* Reduce icon size */
		
		align-items: center !important;
		justify-content: center !important;
		border-radius: 8px !important; /* Soft rounded edges */
		background-color: royalblue !important;
		color: white !important;
		padding: 5px !important; /* Space around the icon */
		margin: 5px !important; /* Space between icons */
	}
		.icon-shape:hover {
			background-color: dodgerblue;
			transform: scale(1.1);
		}

	.input-group .input-group-text {
		background: white;
		border: none;
		cursor: pointer;
	}

		.input-group .input-group-text:hover {
			background: rgba(0, 0, 0, 0.05);
		}
	/* User Dropdown */
	#userDropdown {
		font-weight: 600;
	}

		#userDropdown:hover {
			color: lightgray !important;
		}

	.icon-royalblue {
		color: royalblue !important;
	}

	.input-group-text {
		padding: 0.5rem; /* Adjust padding to make the icons more aligned */
	}

	.input-group i {
		font-size: 1.25rem; /* Adjust icon size */
	}
	
</style>
<nav class="navbar navbar-expand-lg navbar-dark fixed-top custom-navbar" id="mainNav" style="background-color: cornflowerblue; padding: 10px; ">
	<div class="container">
		<a class="navbar-brand" href="#page-top">
			<img src="/Images/Delco_ImageNew.jpg" alt="..." style="width:80px; height:80px;" />
		</a>

		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
			Menu
			<i class="fas fa-bars ms-1"></i>
		</button>

		<div class="collapse navbar-collapse" id="navbarResponsive">
			<ul class="navbar-nav ms-auto py-4 py-lg-0 align-items-center">
				<li class="nav-item"><a class="nav-link" href="/" style="color: white;" data-bs-toggle="tooltip" title="Home"><i class="fa-solid fa-house icon-shape" style="width:20px; height:20px;"></i></a></li>
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle" href="/#menu" id="menuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: white;"  title="Menu">
						<i class="fa-solid fa-bars icon-shape" style="width:30px; height:30px;"></i>
					</a>
				</li>



				<!-- Dropdown Menu with Bars Icon -->
				
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle" href="#" id="optionsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Options">
						<i class="fa-solid fa-ellipsis icon-shape"></i>
					</a>
					<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="optionsDropdown">
						<li><a class="dropdown-item" href="#userContactInfo"><i class="fa-solid fa-address-book fa-lg me-2 icon-royalblue"></i> User Contact Info</a></li>
						<li><a class="dropdown-item" href="#clientDashboard"><i class="fa-solid fa-tachometer-alt fa-lg me-2 icon-royalblue"></i> Client Dashboard</a></li>
						<li><a class="dropdown-item" href="#changeProject"><i class="fa-solid fa-sync-alt fa-lg me-2 icon-royalblue"></i> Change Project</a></li>
						<li><a class="dropdown-item" href="#documentManagement"><i class="fa-solid fa-file-alt fa-lg me-2 icon-royalblue"></i> Document Management</a></li>
						<li><a class="dropdown-item" href="#support"><i class="fa-solid fa-headset fa-lg me-2 icon-royalblue"></i> Support</a></li>
						<li><a class="dropdown-item" href="#inbox"><i class="fa-solid fa-inbox fa-lg me-2 icon-royalblue"></i> Inbox</a></li>
						<li><a class="dropdown-item" href="#forwardMessage"><i class="fa-solid fa-share fa-lg me-2 icon-royalblue"></i> Forward Message</a></li>
						<li><a class="dropdown-item" href="#dashboard"><i class="fa-solid fa-th-large fa-lg me-2 icon-royalblue"></i> Dashboard</a></li>
						<li><a class="dropdown-item" href="#erap"><i class="fa-solid fa-medkit fa-lg me-2 icon-royalblue"></i> ERAP</a></li>
						<li><a class="dropdown-item" href="#financialAssistance"><i class="fa-solid fa-dollar-sign fa-lg me-2 icon-royalblue"></i> Financial Assistance</a></li>
						<li><a class="dropdown-item" href="#waitingList"><i class="fa-solid fa-hourglass-half fa-lg me-2 icon-royalblue"></i> Waiting List</a></li>
						<li><a class="dropdown-item" href="#exit"><i class="fa-solid fa-sign-out-alt fa-lg me-2 icon-royalblue"></i> Exit</a></li>
					</ul>
				</li>

				<!-- Search Form -->
				<form class="d-flex ms-lg-3 me-lg-4 align-items-center" role="search">
					<div class="input-group">
						<input class="form-control" type="search" placeholder="Search" aria-label="Search" value="john Doe - Enrolled" />
						<span class="input-group-text bg-light border-0" data-bs-toggle="tooltip" title="Search" >
							<i class="fas fa-search text-dark icon-royalblue"></i>
						</span>
						<span class="input-group-text bg-light border-0" data-bs-toggle= "tooltip" title="Family Members" >
							<i class="fa-solid fa-users text-dark icon-royalblue"></i>
						</span>
					</div>
				</form>
				
				<li class="nav-item">
					<a class="nav-link " href="/#ContactUs" style="color: white;" data-bs-toggle="tooltip" title="Contact us">
						<i class="fa-solid fa-phone icon-shape" style="width:20px; height:20px;"></i> <!-- Example phone icon -->
					</a>
				</li>
				<!-- Username Display and User Dropdown -->
				@if (userName != null)
				{
					<li class="nav-item dropdown">
						<a class="nav-link  dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							@userName - Delaware County
						</a>
						<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
							<li><a class="dropdown-item" href="/Account/Settings">Account Settings</a></li>
							<li><hr class="dropdown-divider" /></li>
							<li><a class="dropdown-item" href="/Account/Logout">Logout</a></li>
						</ul>
					</li>
				}
			</ul>
		</div>
	</div>
</nav>



