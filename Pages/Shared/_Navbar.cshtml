<style>
	.dropdown-menu {
		z-index: 1050 !important;
	}

	.custom-navbar {
		background-color: cornflowerblue !important;
		padding: 15px 30px;
		/* border-radius: 15px; */
		/* background: linear-gradient(to right, #4e73df, #6a89cc); */ /* Smooth color flow */
		transition: all 0.3s ease-in-out;

	}

		/* Custom CSS for navbar links */
		.custom-navbar .nav-link {
			color: white !important;
			font-weight: 600;
			padding: 10px 15px;
			border-radius: 10px;
			transition: background 0.3s ease, color 0.3s ease;
		}

			/* Ensure the hover state also stays white */
			.custom-navbar .nav-link:hover {
				background-color: rgba(255, 255, 255, 0.2);
				color: lightgrey !important;
			}

	
		/* Dropdown Menu Styling */
		.custom-navbar .dropdown-menu {
			background-color: white;
		border-radius: 0; /* Remove rounded corners */
		box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
			padding: 10px;
			min-width: 220px;
		}

		/* Dropdown menu items */
		.custom-navbar .dropdown-item {
			color: black !important;
			font-weight: 500;
			padding: 10px 15px;
			border-radius: 5px;
			transition: background 0.3s ease;
		}

			/* Ensure the hover state also stays white */
			.custom-navbar .dropdown-item:hover {
				background-color: rgba(0, 0, 0, 0.05);
				color: darkblue;
			}

	/* Sidebar Styles */
	#sidebar-wrapper {
		/* min-width: 250px;
		max-width: 280px; */
		width:250px;
		/* background-color: #4e73df; */ /* Primary color */
		color: white;
		position: fixed;
		top: 0;
		left: 0;
		bottom: 0;
		height: 100vh; /* Set the height to fill the entire viewport */
		overflow-y: auto; /* Add scroll if the content exceeds the height */
		transition: width 0.3s ease-in-out; /* Smooth transition for toggling */
		padding-right: 20px;
		margin-top: 110px;
		background: linear-gradient(to bottom, #4e73df, #6a89cc); /* Matching navbar */
		box-shadow: 2px 0px 10px rgba(0, 0, 0, 0.1);
		overflow-y: auto; /* Enable vertical scrolling */
		z-index: 100;
	}
		/* Ensure the content inside the sidebar can scroll */
		#sidebar-wrapper .list-group {
			max-height: calc(100vh - 60px); /* Set maximum height for the sidebar list (adjust 60px for any header height) */
			overflow-y: auto; /* Enable vertical scrolling */
		}
	.hr {
		border-top: 2px solid #fff;
		width: 100%; /* Ensure it spans the full width */
		margin: 10px 0; /* Adjust margin for spacing */
	}
	/* For mobile, hide the sidebar */
	.d-none {
		display: none !important;
	}
	.sidebar-heading {
		padding: 5px 20px;
		display: flex; /* Use flexbox for alignment */
		justify-content: space-between; /* Ensures equal spacing between the Menu text and the button */
		align-items: center; /* Aligns items vertically in the center */
	}

	/* Styling for the sidebar divider */
	.sidebar-divider {
		border-top: 2px solid #fff; /* White line */
		width: 80%; /* Adjust width to leave space on the sides */
		margin-top: 10px; /* Add space between the Menu and the rule */
		margin-left: 10px; /* Optional: Add some space before the line */
		margin-right: 10px; /* Optional: Add some space after the line */
		margin-bottom: 20px; /* Add some space below the rule */
	}

	#sidebar-wrapper.collapsed {
		width: 60px;
	}

		#sidebar-wrapper.collapsed .button-text {
			display: none;
		}

	#menuToggleMobile {
		position: absolute;
		top: 10px;
		left: 10px;
	}

	.list-group-item {
		background-color: #ffffff; /* White background for items */
		color: black; /* Primary color text */
		padding: 10px;
		border: none;
	}

		.list-group-item:hover {
			/* background-color: lightgray; */ /* Light hover effect */
			background-color: rgba(255, 255, 255, 0.2);
			color: #f8f9fc;
		}

	.collapse {
		transition: height 0.3s ease-in-out;
	}
	.card {
		border: none;
		box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .075);
		margin-bottom: 15px;
		background-color: #ffffff; /* White card background */
	}

	.card-body {
		padding: 20px;
	}

	.sb-admin-item a {
		font-weight: 500;
		text-decoration: none;
	}

		.sb-admin-item a:hover {
			color: #2c3e50; /* Darker text color on hover */
		}

	/* Equal height button */
	.equal-btn {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	/* Sidebar collapse button */
	#sidebarToggle {
		background-color: transparent;
		border: none;
		color: white;
		font-size: 1.5rem;
	}

	/* Additional spacing for submenus */
	.scrollable-list {
		max-height: 300px;
		overflow-y: auto;
	}

	/* Adjusting the content to avoid overlap with the fixed navbar */
	/* .container {
			margin-top: 70px; /* Adjust based on the navbar height */

	/* Ensure that the sidebar content doesn't overflow or affect other elements */
	#page-content-wrapper {
		/* margin-left: 250px; */ /* Make space for the sidebar */
		padding: 20px;
		transition: margin-left 0.3s ease; /* Smooth transition when toggling sidebar */
	}

	.bg-custom {
		background-color: #4e73df; /* Custom dark blue */
	}

