	.icon-shape {
		width: 35px !important; /* Smaller square size */
		height: 35px !important;
		font-size: 16px !important; /* Reduce icon size */
		
		align-items: center !important;
		justify-content: center !important;
		border-radius: 8px !important; /* Soft rounded edges */
		background-color: royalblue !important;
		color: white !important;
		padding: 5px !important; /* Space around the icon */
		margin: 5px !important; /* Space between icons */
	}
		.icon-shape:hover {
			background-color: dodgerblue;
			transform: scale(1.1);
		}

	.input-group .input-group-text {
		background: white;
		border: none;
		cursor: pointer;
	}

		.input-group .input-group-text:hover {
			background: rgba(0, 0, 0, 0.05);
		}
	/* User Dropdown */
	#userDropdown {
		font-weight: 600;
