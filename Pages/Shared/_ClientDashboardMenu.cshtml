@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
 
   
}
<style>
    .container.mt-8 {
        margin-top: 120px;
    }
    .horizontal-menu {
        display: flex;
        /*   justify-content: center; */ /* Center horizontally */
        gap: 20px; /* Space between links */
        padding: 10px 0;
        padding: 5px 0; /* Reduce padding for tighter spacing */
        margin-top: 0; /* Ensure no gap from the h2 */
    }

    .menu-link {
        text-decoration: none;
        color: black; /* Keep text black */
        font-weight: bold;
        font-size: 16px;
        padding: 8px 15px;
        position: relative;
        transition: color 0.3s ease-in-out;
    }

        /* Underline Effect on Hover */
        .menu-link::after {
            content: "";
            display: block;
            width: 0;
            height: 2px;
            background-color: #007bff; /* Blue highlight */
            position: absolute;
            left: 50%;
            bottom: -2px;
            transition: width 0.3s ease-in-out, left 0.3s ease-in-out;
        }

        /* Hover Effect */
        .menu-link:hover {
            color: #007bff; /* Change text color on hover */
        }

            .menu-link:hover::after {
                width: 100%;
                left: 0;
            }
    

    

        /* Active menu item */
        .menu-link.active {
            color: #007bff;
            font-weight: bold;
            position: relative;
        }

            /* Blue underline only for active item */
            .menu-link.active::after {
                content: "";
                display: block;
                width: 100%;
                height: 2px;
                background-color: #007bff;
                position: absolute;
                left: 0;
                bottom: -2px;
            }

        /* Hover effect - only text color changes */
        .menu-link:hover {
            color: #007bff;
        }

        .highlight-header
        {
           
        text-align: left !important;
        margin: 0; /* Ensure no extra space */
        padding: 0; /* Remove padding if needed */
        }

       
</style>


<div class="card shadow-sm p-3" style="margin-top:120px;">

@* <div class="container mt-8 form-container" style="padding-bottom: 0;">
 *@    <h2 class="highlight-header" style="margin-bottom: 0;">Client Dashboard</h2>

    <div class="horizontal-menu" style="margin-bottom: 0;">
        <a class="menu-link @(currentPage == "/ClientDashboard/CoordinatedEntry" ? "active" : "")" asp-page="/ClientDashboard/CoordinatedEntry">Coordinated Entry</a>
        <a class="menu-link @(currentPage == "/ClientDashboard/ClientSummary" ? "active" : "")" asp-page="/ClientDashboard/ClientSummary">Client Summary</a>
        <a class="menu-link @(currentPage == "/ClientDashboard/CaseManagement" ? "active" : "")" asp-page="/ClientDashboard/CaseManagement">Case Management</a>
        <a class="menu-link @(currentPage == "/ClientDashboard/SpecialServices" ? "active" : "")" asp-page="/ClientDashboard/SpecialServices">Special Services</a>
        <a class="menu-link @(currentPage == "/ClientDashboard/FinancialAssistance" ? "active" : "")" asp-page="/ClientDashboard/FinancialAssistance">Financial Assistance</a>
    </div>
</div>
