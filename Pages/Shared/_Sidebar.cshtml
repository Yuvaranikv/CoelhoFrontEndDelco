<style>
	/* Sidebar Styles */
	#sidebar-wrapper {
		/* min-width: 250px;
			max-width: 280px; */
		width: 270px;
		/* background-color: #4e73df; */ /* Primary color */
		color: white;
		position: fixed;
		top: 0;
		left: 0;
		bottom: 0;
		height: 100vh; /* Set the height to fill the entire viewport */
		overflow-y: auto; /* Add scroll if the content exceeds the height */
		transition: width 0.3s ease-in-out; /* Smooth transition for toggling */
		padding-right: 20px;
		margin-top: 110px;
		background: linear-gradient(to bottom, #4e73df, #6a89cc); /* Matching navbar */
		box-shadow: 2px 0px 10px rgba(0, 0, 0, 0.1);
		overflow-y: auto; /* Enable vertical scrolling */
		z-index: 100;
	}
		/* Ensure the content inside the sidebar can scroll */
		#sidebar-wrapper .list-group {
			max-height: calc(100vh - 60px); /* Set maximum height for the sidebar list (adjust 60px for any header height) */
			overflow-y: auto; /* Enable vertical scrolling */
		}

	.hr {
		border-top: 2px solid #fff;
		width: 100%; /* Ensure it spans the full width */
		margin: 10px 0; /* Adjust margin for spacing */
	}
	/* For mobile, hide the sidebar */
	.d-none {
		display: none !important;
	}


	#menuToggleMobile {
		position: absolute;
		top: 10px;
		left: 10px;
	}
	.sidebar-heading {
		padding: 5px 20px;
		display: flex; /* Use flexbox for alignment */
		justify-content: space-between; /* Ensures equal spacing between the Menu text and the button */
		align-items: center; /* Aligns items vertically in the center */
	}

	/* Styling for the sidebar divider */
	.sidebar-divider {
		border-top: 2px solid #fff; /* White line */
		width: 80%; /* Adjust width to leave space on the sides */
		margin-top: 10px; /* Add space between the Menu and the rule */
		margin-left: 10px; /* Optional: Add some space before the line */
		margin-right: 10px; /* Optional: Add some space after the line */
		margin-bottom: 20px; /* Add some space below the rule */
	}

	#sidebar-wrapper.collapsed {
		width: 60px;
	}

		#sidebar-wrapper.collapsed .button-text {
			display: none;
		}
	.list-group-item {
		background-color: #ffffff; /* White background for items */
		color: black; /* Primary color text */
		padding: 10px;
		border: none !important;
	}

		.list-group-item:hover {
			/* background-color: lightgray; */ /* Light hover effect */
			background-color: rgba(255, 255, 255, 0.2);
			color: #f8f9fc;
		}
	/* Sidebar collapse button */
	#sidebarToggle {
		background-color: transparent;
		border: none;
		color: white;
		font-size: 1.5rem;
	}

	/* Additional spacing for submenus */
	.scrollable-list {
		max-height: 300px;
		overflow-y: auto;
	}

	.collapse {
		transition: height 0.3s ease-in-out;
	}

	.card {
		border: none;
		box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .075);
		margin-bottom: 15px;
		background-color: #ffffff; /* White card background */
	}

	.card-body {
		padding: 20px;
	}

	.sb-admin-item a {
		font-weight: 500;
		text-decoration: none;
	}

		.sb-admin-item a:hover {
			color: #2c3e50; /* Darker text color on hover */
		}
</style>
