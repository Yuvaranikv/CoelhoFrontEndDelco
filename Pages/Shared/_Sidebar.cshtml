<script>
	document.addEventListener("DOMContentLoaded", function () {
		const sidebar = document.getElementById("sidebar-wrapper");
		const pageContentWrapper = document.getElementById("page-content-wrapper");
		const menuLink = document.getElementById("menuLink");
		const closeButton = document.getElementById("sidebarToggle");
		const masthead = document.querySelector('.masthead');

		// Function to toggle sidebar visibility
		function toggleSidebar() {
			sidebar.classList.toggle("d-none");

			// Adjust the content margin when sidebar is shown or hidden
			if (sidebar.classList.contains("d-none")) {
				pageContentWrapper.style.marginLeft = "0"; // No space when sidebar is hidden
				masthead.style.marginLeft = "0"; // Reset masthead position
			} else {
			//	pageContentWrapper.style.marginLeft = "250px"; // Space for the sidebar when visible
				//masthead.style.marginLeft = "250px"; // Shift masthead when sidebar is visible
			}
		}

		// Toggle sidebar when clicking the menu link
		if (menuLink) {
			menuLink.addEventListener("click", function (event) {
				event.preventDefault();
				toggleSidebar();
			});
		}

		// Hide sidebar when clicking the close button inside the sidebar
		if (closeButton) {
			closeButton.addEventListener("click", function () {
				sidebar.classList.add("d-none"); // Hide sidebar
				pageContentWrapper.style.marginLeft = "0"; // Reset content margin
				masthead.style.marginLeft = "0"; // Reset masthead position
			});
		}
	});
</script>