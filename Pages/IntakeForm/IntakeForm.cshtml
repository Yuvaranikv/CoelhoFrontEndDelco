<script>
	function navigateToFamilyScreen() {
		 window.location.href = '/IntakeFamilyMember/IntakeFamilyMember'; 
	// Adjust based on your routing
	}
		// Mock function to simulate form completion
	function markAsCompleted(buttonElement) {
		buttonElement.classList.add('completed');
		alert('Details submitted successfully!');
	}
</script>
<!-- IntakeForm.cshtml -->
<script>
	window.onload = function () {
		// Check if Family Member details are filled
		if (localStorage.getItem('familyMemberFilled') === 'true') {
			const familyMemberButton = document.querySelector('.family-member-btn');
			if (familyMemberButton) {
				familyMemberButton.classList.remove('btn-custom');
				familyMemberButton.classList.add('btn-success');
			}
		}

		// Clear localStorage for familyMemberFilled after page load
		localStorage.removeItem('familyMemberFilled');
	};
</script>

