@page
@model TURN.Pages.ImmediateHealthIssuesModel
@{
    Layout = "_LayoutLatest";
}

<div style="margin-bottom: 120px;"></div>
@await Html.PartialAsync("Shared/_IntakeGeneralDetails")

<div id="ImmediateHealthIssueSection">
    <div class="container mt-8 form-container">
        <h2 class="highlight-header mt-4">Immediate Health Issues</h2>

        <h2>Health Issues Information  <button class="btn btn-primary float-end" id="addHealthIssueBtn">+</button></h2>
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th>Family Member</th>
                    <th>Health Issue</th>
                  
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Name</td>
                    <td>Health Issue Type</td>
                
                    <td>
                        <button class="btn btn-sm btn-warning">
                            Edit <i class="fas fa-edit"></i>
                        </button>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-danger">
                            Delete <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>

        <div id="formHealthIssueSection" style="display: none;">
            <form action="/api/ImmediateHealth/SubmitForm" method="post">
                <h4 class="mb-4 mt-5">Add Immediate Health Issue</h4>

                <div class="container">

                    <div class="mb-3 row align-items-center">
                        <label for="familyMember" class="col-sm-4 col-form-label required">Family Member</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle" type="button" id="FamilyMemberDisabilityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                                    @*   Select Family Member *@
                                    John Doe
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li><a class="dropdown-item" href="#">John Doe</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Immediate Health Issues Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="immediateHealthIssues" class="col-sm-4 col-form-label required">Immediate Health Issues</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle" type="button" id="HealthIssuesDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                                    Select Immediate Health Issue
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li><a class="dropdown-item" href="#">Contagious Disease (TB, etc)</a></li>
                                    <li><a class="dropdown-item" href="#">Drug Allergies</a></li>
                                    <li><a class="dropdown-item" href="#">Food Allergies</a></li>
                                    <li><a class="dropdown-item" href="#">Injury Untreated</a></li>
                                    <li><a class="dropdown-item" href="#">Insulin Dependent</a></li>
                                    <li><a class="dropdown-item" href="#">Other</a></li>
                                    <li><a class="dropdown-item" href="#">Oxygen Dependent</a></li>
                                    <li><a class="dropdown-item" href="#">Pregnancy</a></li>
                                    <li><a class="dropdown-item" href="#">Serious Injury In Past Six Months</a></li>
                                    <li><a class="dropdown-item" href="#">Serious Illness In Past Six Months</a></li>
                                    <li><a class="dropdown-item" href="#">Suspected Pregnancy</a></li>
                                    <li><a class="dropdown-item" href="#">Sexually Transmitted Diseases</a></li>
                                    <li><a class="dropdown-item" href="#">Recurring Health Problems</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                   
                    <div class="d-flex justify-content-between mt-3">
                        <button class="btn btn-secondary" type="button">Go Back</button>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Show form when + button is clicked
    document.getElementById('addHealthIssueBtn').addEventListener('click', function () {
        document.getElementById('formHealthIssueSection').style.display = 'block';
    });

    // Handle form submission on Save button click
    function handleSaveHealthIssue() {
        alert('Immediate Health Issue Added!');
        document.getElementById('formHealthIssueSection').style.display = 'none';
    }
</script>
