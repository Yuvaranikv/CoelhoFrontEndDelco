<script>
	document.getElementById('ContactPhone').addEventListener('input', function (e) {
		let value = e.target.value.replace(/\D/g, ''); // Remove non-numeric characters
		let formattedValue = '';

		if (value.length <= 3) {
			formattedValue = '(' + value;
		} else if (value.length <= 6) {
			formattedValue = '(' + value.slice(0, 3) + ') ' + value.slice(3);
		} else {
			formattedValue = '(' + value.slice(0, 3) + ') ' + value.slice(3, 6) + '-' + value.slice(6, 10);
		}

		// Set the value to the formatted phone number
		e.target.value = formattedValue;
	});
</script>

<script>
	function handleSave() {
		// Show success alert
		alert("Family Member details saved successfully!");

		// Redirect to the intake form screen
		window.location.href = '/IntakeForm/IntakeForm'; // Adjust this to the correct route

		// Change the Family Member button to green in the intake form
		localStorage.setItem('familyMemberFilled', 'true');
	}

	// When the page loads, check if Family Member details are filled
	window.onload = function () {
		if (localStorage.getItem('familyMemberFilled') === 'true') {
			const familyMemberButton = document.querySelector('.family-member-btn');
			if (familyMemberButton) {
				familyMemberButton.classList.remove('btn-primary');
				familyMemberButton.classList.add('btn-success');
			}
		}
	};
</script>