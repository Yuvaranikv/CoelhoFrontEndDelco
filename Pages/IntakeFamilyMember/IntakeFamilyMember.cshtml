									</li>
								</ul>
							</div>

							<!-- Ellipsis Icon -->
							<button class="ellipsis-icon-btn" type="button" data-bs-toggle="modal" data-bs-target="#HOHRelationshipModal">
								<i class="fas fa-ellipsis-h"></i>
								
							</button>
						</div>
					</div>

					<div class="mb-3 row">
						<label for="DateOfBirth" class="col-sm-4 col-form-label required">Date of Birth</label>
						<div class="col-sm-6 d-flex align-items-center position-relative">
							<!-- Input Box -->
							<input type="date" name="DateOfBirth" class="form-control" id="DateOfBirth" style="padding-right: 35px;">

							<!-- Dropdown for Ellipsis Icon -->
							<div class="dropdown position-absolute" style="top: 50%; right: 0px; transform: translateY(-50%);">
								<button class="ellipsis-icon-btn" type="button" id="optionsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
									<i class="fas fa-ellipsis-h"></i>
									
								</button>

