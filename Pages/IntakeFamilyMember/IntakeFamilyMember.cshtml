@page
@model IntakeFamilyMemberModel;
@{
	Layout = "_LayoutLatest";
}




<style>




/* Position search icon inside button */
.form-container .dropdown-toggle i {
	right: 15px; /* Align with input field padding */
	font-size: 1rem;
	color: gray;
}

/* Align Label and Input on Same Line */
.form-container .d-flex {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

/* Reduce Width for Number Inputs */
.form-container input[type="number"] {
	width: auto;
}

	

	.form-container .form-control {
		padding-right: 50px; /* Enough space for the icon */
	}

	.form-container .military-service-options {
		display: flex;
		flex-direction: column;
		align-items: flex-start; /* Align items to the start vertically */
		gap: 0.5rem;
	}


</style>

<div style="margin-bottom: 120px;"></div>
@await Html.PartialAsync("Shared/_IntakeGeneralDetails")
<div id="familyMemberSection">
	<!-- Family member form will be dynamically inserted here -->
	<div class="container mt-8 form-container">
		<h2 class="highlight-header mt-4">Intake Family Member </h2>

		<h2>Family Member Information <button class="btn btn-primary float-end" id="addMemberBtn">+</button></h2>
		<table class="table table-bordered mt-3">
			<thead>
				<tr>
					<th>Client Name</th>
					<th>Relationship to HOH</th>
					<th>Social Security Number</th>
					<th>Age</th>
					<th>Gender</th>
					<th>Veteran Status</th>
					<th>Edit</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td></td>
					<td></td>
					<td></td>
					<td></td>
					<td></td>
					<td></td>
					<td><button class="btn btn-sm btn-warning">Edit</button></td>
				</tr>
			</tbody>
		</table>
		<div id="addMemberForm" style="display: none;">


			<form action="/api/IntakeFamilyMember/SubmitForm" method="post">
				<h4 class="mb-4 mt-5">Demographics Information</h4>

				<div class="container">
					<!-- Social Security Number -->
					<div class="mb-3 row align-items-center">
						<label for="SSN" class="col-sm-4 col-form-label required">Social Security Number</label>
						<div class="col-sm-6 d-flex align-items-center position-relative gap-2 flex-row">
							<input type="text" name="SSN" class="form-control" id="SSN" placeholder="___-__-____">
							<button class="ellipsis-icon-btn" type="button" id="optionsDropdown" data-bs-toggle="dropdown">
								<i class="fas fa-ellipsis-h"></i>
							</button>
							<ul class="dropdown-menu">
								<li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#SSNModal">Help</a></li>
								<li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#pdfModal">Download PDF</a></li>
							</ul>
						</div>
					</div>
					
					<!-- SSN Data Quality -->
					<div class="mb-3 row align-items-center">
						<label for="SSNData" class="col-sm-4 col-form-label required">SSN Data Quality</label>
						<div class="col-sm-6">
							<div class="dropdown w-100">
								<button class="btn btn-white w-100 dropdown-toggle" type="button" id="SSNDataQualityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
									Select SSN Data Quality
								</button>

								<ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Full SSN reported
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Approximate or partial SSN reported
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Don't know
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Client prefers not to answer
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Data not collected
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> If Other, (please explain)
										</label>
										<input type="text" class="form-control mt-2">
									</li>

									<li>
										<button class="btn btn-primary mt-2 w-100" id="OKButtonSSNDataQuality">OK</button>
									</li>
								</ul>
							</div>
						</div>
					</div>


					<!-- First Name -->
					<div class="mb-3 row align-items-center">
						<label for="FirstName" class="col-sm-4 col-form-label required">First Name</label>
						<div class="col-sm-6 d-flex align-items-center position-relative gap-2 flex-row">
							<input type="text" name="FirstName" class="form-control" id="FirstName">
							<button class="ellipsis-icon-btn ms-2" type="button" data-bs-toggle="modal" data-bs-target="#FirstNameModal">
								<i class="fas fa-ellipsis-h"></i>
							</button>
						</div>
					</div>

					<!-- Middle Name -->
					<div class="mb-3 row align-items-center">
						<label for="MiddleName" class="col-sm-4 col-form-label">Middle Name</label>
						<div class="col-sm-6">
							<input type="text" name="MiddleName" class="form-control" id="MiddleName">
						</div>
					</div>

					<!-- Last Name -->
					<div class="mb-3 row align-items-center">
						<label for="LastName" class="col-sm-4 col-form-label required">Last Name</label>
						<div class="col-sm-6">
							<input type="text" name="LastName" class="form-control" id="LastName">
						</div>
					</div>

					<!-- Name Data Quality -->
					<div class="mb-3 row">
						<label for="NameDataQuality" class="col-sm-4 col-form-label">Name Data Quality</label>
						<div class="col-sm-6">
							<div class="dropdown w-100">
								<button class="btn btn-white w-100 dropdown-toggle" type="button" id="NameDataQualityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
									Select Name Data Quality
								</button>

								<ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Full name reported
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Partial, Street, anonymous or code name reported
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Don't Know
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Client prefers not to answer
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Data not collected
										</label>
									</li>

									<li>
										<button class="btn btn-primary mt-2 w-100" id="OKButtonNameDataQuality">OK</button>
									</li>
								</ul>
							</div>
						</div>
					</div>




					<div class="mb-3 row">
						<label for="PreferredNamePronoun" class="col-sm-4 col-form-label">Preferred Name / Pronoun</label>
						<div class="col-sm-6">
							<input type="text" name="PreferredNamePronoun" class="form-control" id="PreferredNamePronoun" placeholder="Preferred Name / Pronoun">
						</div>
					</div>

					<div class="mb-3 row align-items-center">
						<label for="HOHRelationshipDropdown" class="col-sm-4 col-form-label required">HOH or Relationship to HOH</label>
						<div class="col-sm-6 position-relative d-flex align-items-center">
							<!-- Dropdown Button -->
							<div class="dropdown w-100">
								<button class="btn btn-white w-100 dropdown-toggle" type="button" id="HOHRelationshipDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
									Select HOH or Relationship to HOH
								</button>

								<ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Self (head of household)
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Head of household's child
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Head of household's spouse or partner
