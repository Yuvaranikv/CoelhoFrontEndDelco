						<div class="col-sm-6 position-relative">
							<!-- Dropdown Button -->
							<div class="dropdown w-100">
								<button class="btn btn-white w-100 dropdown-toggle" type="button" id="DateOfBirthTypeDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
									Select Date of Birth Type
								</button>

								<ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Full DOB Reported
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Approximate or Partial DOB Reported
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Don't know
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Client prefers not to answer
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> Data not collected
										</label>
									</li>
									<li>
										<label class="form-check-label d-block">
											<input type="checkbox" class="form-check-input"> If Other, (please explain)
										</label>
										<input type="text" class="form-control mt-2">
									</li>
									<li>
										<button class="btn btn-primary mt-2 w-100" id="OKButtonDOBType">OK</button>
									</li>
								</ul>
							</div>
						</div>
					</div>

					<div class="mb-3 row align-items-center">
