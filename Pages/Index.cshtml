<style>
	/* Container for announcement and user info sections */
	.info-section {
		display: flex;
		gap: 20px;
		margin: 20px 0;
	}

	/* Announcement Section */
	.announcement {
		flex: 1;
		background-color: #f8f9fa;
		padding: 15px;
		border-radius: 10px;
		height: 250px;
		overflow: hidden;
		position: relative;
	}

	/* Fixed heading, no scrolling over it */
	.announcement-header {
		font-size: 1.2rem;
		font-weight: bold;
		margin-bottom: 10px;
		background-color: royalblue;
		padding: 8px;
		border-radius: 8px;
		color:white;
	}

	/* Scrolling list styling */
	.announcement-content {
		height: 190px;
		overflow: hidden;
		position: relative;
	}

	.announcement-list {
		padding: 0;
		margin: 0;
		list-style-type: none;
	}

		.announcement-list li {
			padding: 10px 0;
			border-bottom: 1px solid #ddd;
			background: #ffffff;
		}

	/* User Info Section */
	.user-info {
		width: 300px;
		background-color: #f0f0f0;
		padding: 15px;
		border-radius: 10px;
	}


</style>
