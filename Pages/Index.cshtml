@page
@model IndexModel
@{
    ViewData["Title"] = "TURN";
}

<style>
	/* Container for announcement and user info sections */
	.info-section {
		display: flex;
		gap: 20px;
		margin: 20px 0;
		margin-top: 6vh; /* Adding some margin to ensure it starts below the sticky header */
	}

	/* Announcement Section */
	.announcement {
		flex: 1;
		background-color: #f8f9fa;
		padding: 15px;
		border-radius: 10px;
		height: 250px;
		overflow: hidden;
		position: relative;
	}

	/* Fixed heading, no scrolling over it */
	.announcement-header {
		font-size: 1.2rem;
		font-weight: bold;
		margin-bottom: 10px;
		background-color: royalblue;
		padding: 8px;
		border-radius: 8px;
		color:white;
	}

	/* Scrolling list styling */
	.announcement-content {
		height: 190px;
		overflow: hidden;
		position: relative;
	}

	.announcement-list {
		padding: 0;
		margin: 0;
		list-style-type: none;
	}

		.announcement-list li {
			padding: 10px 0;
			border-bottom: 1px solid #ddd;
			background: #ffffff;
		}

	/* User Info Section */
	.user-info {
		width: 300px;
		background-color: #f0f0f0;
		padding: 15px;
		border-radius: 10px;
	}


</style>
<div class="container" >
    @* Light blue background for the entire container *@
    <!-- Masthead-->
    <header class="masthead" id="slideshow-header">
        <div class="container">
            <div class="masthead-subheading">Welcome To Cares!</div>
            <div class="masthead-heading text-uppercase">It's Nice To Meet You</div>
        </div>
    </header>

	<div class="info-section">
		<!-- Announcement Section -->
		<div class="announcement">
			<div class="announcement-header ">Announcements</div>
			<div class="announcement-content">
				<ul class="announcement-list" id="announcementList">
					<li>01/02/2024 - Support: For any immediate HMIS problem, call Jinumon Gopidasan at 484-889-1846.</li>
					<li>01/09/2024 - Activity Screen: Updates to the Activity screen let you add notes for family members.</li>
					<li>12/03/2023 - Coordinated Entry Assessment: New forms for CE assessors.</li>
					<li>10/03/2023 - HMIS Standards 2024: Guides and training videos available.</li>
					<li>08/03/2023 - Case Management: Supportive Services renamed with added features.</li>
					<li>04/17/2023 - Checklist Update: Enhanced system for organizing tasks.</li>
				</ul>
			</div>
		</div>

		<!-- User Info Section -->
		<div class="user-info">
			<h3 class="announcement-header">User Info</h3>
			<ul>
				<li>1615 new Inbox message(s)</li>
				<li>0 Checklist task(s) pending</li>
				<li>1 Active Client(s) (HOH Only)</li>
				<li>4 OBH Client(s) (HOH Only)</li>
				<li>0 Veteran Client(s)</li>
			</ul>
		</div>
	</div>

</div>
	

<script>
	const announcementList = document.getElementById("announcementList");

	function startScrolling() {
		const firstItem = announcementList.firstElementChild;

		// Smooth scrolling effect with reduced speed
		announcementList.style.transition = "transform 2s";
		announcementList.style.transform = `translateY(-${firstItem.offsetHeight}px)`;

		setTimeout(() => {
			announcementList.appendChild(firstItem);
			announcementList.style.transition = "none";
			announcementList.style.transform = "translateY(0)";
		}, 2000);
	}

	// Scroll every 4 seconds
	setInterval(startScrolling, 1000);
</script>