@page
@model TURN.Pages.IntakeClientMaster.IntakeClientMasterModel
@{
	Layout = "_LayoutLatest";
}



<style>
   

    h2 {
        text-align: center;
        background-color: #007bff;
        color: white;
        padding: 10px;
        border-radius: 5px;
    }

    /* Label and input alignment */
    .form-row {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

        .form-row label {
            width: 200px;
            font-size: 1rem;
            color: #333;
        }

        .form-row input,
        .form-row select {
            flex: 1;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 1rem;
        }

    /* Mandatory field styling */
    label.required::after {
        content: " *";
        color: red;
    }

    /* Button group */
    .btn-group {
        display: flex;
        justify-content: flex-start;
        margin-top: 20px;
    }

    .btn-custom {
        margin-right: 10px;
        padding: 10px 20px;
        border-radius: 5px;
    }

    

   

    
    
    /* Ensure the label and input stay on the same line */
    .form-container .col-sm-6.d-flex.align-items-center {
        display: flex;
        align-items: center;
    }

    /* Reduce the input width */
    .form-container input[type="number"] {
        width: auto;
    }

    .dropdown-text {
        color: #6c757d; /* Gray color */
    }
    /* Button hover effect */
   

   

</style>

<div class="container mt-8 form-container ">
    <div class="card shadow-sm p-4 mb-3" >
    <h2 class="highlight-header mt-4">Client Identification</h2>
        <form method="post">
            <!-- Form fields -->
        <div class="mb-3 row align-items-center">
            <label for="firstName" class="col-sm-4 col-form-label required" >First Name</label>
            <div class="col-sm-6 d-flex align-items-center position-relative gap-2">
                <input type="text" name="FirstName" class="form-control" id="firstName" placeholder="Enter First Name" required>
                <button class="ellipsis-icon-btn ms-2" type="button" data-bs-toggle="modal" data-bs-target="#FirstNameModal">
                    <i class="fas fa-ellipsis-h"></i>
                </button>
            </div>
        </div>



        <div class="mb-3 row align-items-center">
            <label for="middleName" class="col-sm-4 col-form-label">Middle Name</label>
            <div class="col-sm-6">
                <input type="text" name="MiddleName" class="form-control" id="middleName" placeholder="Enter Middle Name">
            </div>
        </div>

        <div class="mb-3 row align-items-center">
            <label for="lastName" class="col-sm-4 col-form-label required">Last Name</label>
            <div class="col-sm-6">
                <input type="text" name="LastName" class="form-control" id="lastName" placeholder="Enter Last Name" required>
            </div>
        </div>

            <div class="mb-3 row align-items-center">
                <label for="preferredName" class="col-sm-4 col-form-label">Preferred Name</label>
                <div class="col-sm-6">
                    <input type="text" name="PreferredName" class="form-control" id="preferredName" placeholder="Enter Preferred Name/Pronoun">
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label for="suffix" class="col-sm-4 col-form-label">Suffix</label>
                <div class="col-sm-6">
                    <input type="text" name="Suffix" class="form-control" id="suffix" placeholder="Enter Suffix">
                </div>
            </div>

            <div class="mb-3 row">
                <label for="NameDataQuality" class="col-sm-4 col-form-label">Name Data Quality</label>
                <div class="col-sm-6">
                    <div class="dropdown w-100">
                        <button class="btn btn-white w-100 dropdown-toggle" type="button" id="NameDataQualityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                            Full Name Reported
                        </button>

                        <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Full name reported
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Partial, Street, anonymous or code name reported
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Don't Know
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Client prefers not to answer
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Data not collected
                                </label>
                            </li>

                            <li>
                                <button class="btn btn-primary mt-2 w-100" id="OKButtonNameDataQuality">OK</button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label for="SSN" class="col-sm-4 col-form-label required">Social Security Number</label>
                <div class="col-sm-6 d-flex align-items-center position-relative gap-2 flex-row">
                    <input type="text" name="SSN" class="form-control" id="SSN" placeholder="___-__-____">
                    <button class="ellipsis-icon-btn" type="button" id="optionsDropdown" data-bs-toggle="dropdown">
                        <i class="fas fa-ellipsis-h"></i>
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#SSNModal">Help</a></li>
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#pdfModal">Download PDF</a></li>
                    </ul>
                </div>
            </div>


            <div class="mb-3 row align-items-center">
                <label for="SSNData" class="col-sm-4 col-form-label required">SSN Data Quality</label>
                <div class="col-sm-6">
                    <div class="dropdown w-100">
                        <button class="btn btn-white w-100 dropdown-toggle" type="button" id="SSNDataQualityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                            Select SSN Data Quality
                        </button>

                        <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Full SSN reported
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Approximate or partial SSN reported
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Don't know
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Client prefers not to answer
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Data not collected
                                </label>
                            </li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> If Other, (please explain)
                                </label>
                                <input type="text" class="form-control mt-2">
                            </li>

                            <li>
                                <button class="btn btn-primary mt-2 w-100" id="OKButtonSSNDataQuality">OK</button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mb-3 row">
            <label for="DateOfBirth" class="col-sm-4 col-form-label required">Date of Birth</label>
            <div class="col-sm-6 d-flex align-items-center position-relative">
                <!-- Input Box -->
                <input type="date" name="DateOfBirth" class="form-control" id="DateOfBirth" style="padding-right: 35px;">

                <!-- Dropdown for Ellipsis Icon -->
                <div class="dropdown position-absolute" style="top: 50%; right: 0px; transform: translateY(-50%);">
                    <button class="ellipsis-icon-btn" type="button" id="optionsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-ellipsis-h"></i>

                    </button>

                    <!-- Dropdown Menu -->
                    <ul class="dropdown-menu" aria-labelledby="optionsDropdown" style="width: 120px;">
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#DateOfBirthModal">Help</a></li>
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#pdfModal">Download PDF</a></li>
                    </ul>
                </div>
            </div>
        </div>


        <div class="mb-3 row align-items-center">
            <label for="DateOfBirthTypeDropdown" class="col-sm-4 col-form-label required">Date of Birth Type</label>
            <div class="col-sm-6 position-relative">
                <!-- Dropdown Button -->
                <div class="dropdown w-100">
                    <button class="btn btn-white w-100 dropdown-toggle" type="button" id="DateOfBirthTypeDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                        <span id="dropdownButtonText" class="dropdown-text">Full DOB Reported</span>
                    </button>

                    <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Full DOB Reported
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Approximate or Partial DOB Reported
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Don't know
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Client prefers not to answer
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Data not collected
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> If Other, (please explain)
                            </label>
                            <input type="text" class="form-control mt-2">
                        </li>
                        <li>
                            <button class="btn btn-primary mt-2 w-100" id="OKButtonDOBType">OK</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>


        <div class="mb-3 row align-items-center">
            <label for="RaceEthnicityDropdown" class="col-sm-4 col-form-label required">Race and Ethnicity</label>
            <div class="col-sm-6 position-relative d-flex align-items-center">
                <!-- Dropdown Button -->
                <div class="dropdown w-100">
                    <button class="btn btn-white w-100 dropdown-toggle" type="button" id="RaceEthnicityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                        <span id="dropdownButtonText" class="dropdown-text"> Select Race and Ethnicity</span>
                    </button>

                    <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050; font-size: 10px;">
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> American Indian, Alaska Native, or Indigenous
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Asian or Asian American
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Black, African American, or African
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Hispanic/Latina/e/o
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Middle Eastern or North African
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Native Hawaiian or Pacific Islander
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> White
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Don't know
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Client prefers not to answer
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Data not collected
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Additional Race and Ethnicity Detail
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> If Other, (please explain)
                            </label>
                            <input type="text" class="form-control mt-2">
                        </li>
                        <li>
                            <button class="btn btn-primary mt-2 w-30" id="OKButtonRaceEthnicity">OK</button>
                        </li>
                    </ul>
                    </div>
                <button class="ellipsis-icon-btn ms-2" type="button" data-bs-toggle="modal" data-bs-target="#RaceEthnicityModal">
                    <i class="fas fa-ellipsis-h"></i>
                </button>
                </div>

                
        </div>
       
        <div class="mb-3 row">
            <label for="Gender" class="col-sm-4 col-form-label required">Gender</label>
            <div class="col-sm-6 position-relative">
                <!-- Dropdown Button -->
                <div class="dropdown w-100">
                    <button class="btn btn-white w-100 dropdown-toggle" type="button" id="GenderDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                        
                        <span id="dropdownButtonText" class="dropdown-text">Select Gender</span>
                    </button>

                    <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050; font-size: 14px;">
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Woman (Girl if child)</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Man (Boy if child)</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Culturally Specific Identity (e.g., Two-Spirit)</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Non-Binary</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Transgender</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Questioning</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Don't know</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Client prefers not to answer</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Data not collected</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Different Identity</label></li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> If Other, (please explain)
                            </label>
                            <input type="text" class="form-control mt-2" id="OtherGenderExplanation">
                        </li>
                        <li>
                            <button class="btn btn-primary mt-2 w-50" id="OKButtonGender">OK</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="mb-3 row align-items-center">
            <label for="veteranStatusDropdown" class="col-sm-4 col-form-label required">Veteran Status</label>
            <div class="col-sm-6 position-relative d-flex align-items-center">
                <!-- Dropdown Button -->
                <div class="dropdown w-100">
                    <button class="btn btn-white w-100 dropdown-toggle" type="button" id="veteranStatusDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                        <span id="dropdownButtonText" class="dropdown-text"> Select Veteran Status</span>
                    </button>

                    <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Yes
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> No
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Client doesn't know
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Client prefers not to answer
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> Data not collected
                            </label>
                        </li>
                        <li>
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> If Other, (please explain)
                            </label>
                            <input type="text" class="form-control mt-2">
                        </li>
                        <li>
                            <button class="btn btn-primary mt-2 w-100" id="OKButtonVeteranStatus">OK</button>
                        </li>
                    </ul>
                </div>
                <!-- Align Ellipsis Icon Vertically -->
                <button class="ellipsis-icon-btn ms-2" type="button" id="optionsDropdown" data-bs-toggle="dropdown">
                    <i class="fas fa-ellipsis-h"></i>
                </button>
            </div>
        </div>



        <div class="mb-3 row align-items-center">
            <label for="contactPhone" class="col-sm-4 col-form-label">Contact Phone</label>
            <div class="col-sm-6">
                <input type="tel" class="form-control" id="contactPhone" name="ContactPhone" placeholder="(___)-___-____">
            </div>
        </div>


        <div class="mb-3 row align-items-center">
            <label for="sexualOrientationDropdown" class="col-sm-4 col-form-label required">Sexual Orientation</label>
            <div class="col-sm-6 position-relative d-flex align-items-center">
                <!-- Dropdown Button -->
                <div class="dropdown w-100">
                    <button class="btn btn-white w-100 dropdown-toggle" type="button" id="sexualOrientationDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                      
                        <span id="dropdownButtonText" class="dropdown-text">  Select Sexual Orientation</span>
                    </button>

                    <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Heterosexual</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Gay</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Lesbian</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Bisexual</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Questioning OR Unsure</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Other</label></li>
                        <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Client doesn't know</label></li>
                      

                        <li class="mt-2">
                            <label class="form-check-label d-block">
                                <input type="checkbox" class="form-check-input"> If Other, (please explain)
                            </label>
                            <input type="text" class="form-control mt-2" placeholder="Please explain">
                        </li>
                        <li>
                            <button class="btn btn-primary mt-2 w-100" id="OKButtonSexualOrientation">OK</button>
                        </li>
                    </ul>
                </div>
             
            </div>
        </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-secondary" type="button">
                    <i class="fa-solid fa-arrow-left"></i> Go Back
                </button>
                <button type="button" class="btn btn-primary" id="nextButton" data-bs-toggle="modal" data-bs-target="#summaryModal">
                    <i class="fa-solid fa-arrow-right"></i> Save
                </button>
            </div>

    </form>
    </div>
</div>

