@page
@model TURN.Pages.ClientDashboard.ClientDashboardModel
@{
    Layout = "_LayoutLatest";
}

<style>
    .horizontal-menu {
        display: flex;
      /*   justify-content: center; */ /* Center horizontally */
        gap: 20px; /* Space between links */
        padding: 10px 0;
        padding: 5px 0; /* Reduce padding for tighter spacing */
        margin-top: 0; /* Ensure no gap from the h2 */
    }

    .menu-link {
        text-decoration: none;
        color: black; /* Keep text black */
        font-weight: bold;
        font-size: 16px;
        padding: 8px 15px;
        position: relative;
        transition: color 0.3s ease-in-out;
    }

        /* Underline Effect on Hover */
        .menu-link::after {
            content: "";
            display: block;
            width: 0;
            height: 2px;
            background-color: #007bff; /* Blue highlight */
            position: absolute;
            left: 50%;
            bottom: -2px;
            transition: width 0.3s ease-in-out, left 0.3s ease-in-out;
        }

        /* Hover Effect */
        .menu-link:hover {
            color: #007bff; /* Change text color on hover */
        }

            .menu-link:hover::after {
                width: 100%;
                left: 0;
            }
</style>

<div class="container mt-8 form-container">
    <h2 class="highlight-header " style="margin-bottom:0" >Client Dashboard</h2>

    <div class="horizontal-menu">
        <a class="menu-link" asp-page="/ClientDashboard/CoordinatedEntry">Coordinated Entry</a>
        <a class="menu-link" asp-page="/ClientDashboard/ClientSummary">Client Summary</a>
        <a class="menu-link" asp-page="/ClientDashboard/CaseManagement">Case Management</a>
        <a class="menu-link" asp-page="/ClientDashboard/SpecialServices">Special Services</a>
        <a class="menu-link" asp-page="/ClientDashboard/FinancialAssistance">Financial Assistance</a>
    </div>
</div>