@page
@model TURN.Pages.SubstanceAbuseModel
@{
}

<div class="container mt-8 form-container">
    <div class="card shadow-sm p-4 mb-3">
        <h2 class="highlight-header mt-4">Substance Abuse</h2>

       
        <form method="post">
           
            <!-- Type of Addiction -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 col-form-label required">Type of Addiction</label>
                <div class="col-sm-6">
                    <div class="dropdown w-100">
                        <button class="btn btn-white w-100 dropdown-toggle" type="button" id="addictionDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; text-align: left;">
                            Select Type of Addiction
                        </button>
                        <ul class="dropdown-menu w-100 dropdown-menu-end">
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Alcohol</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Cocaine</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Crack</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Heroin</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Codeine/morphine/Percodan/Percocet</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Tylox/Oxycontin/Vicodin/Darvon/Darvocet</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Inhalants (glue, solvents, paint)</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Marijuana/Hashish</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Methadone</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Methamphetamine (Meth, Crank)</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Speed/Crystal Meth</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Dexedrine</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> PCP</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Valium/Ativan/Librium/Xanax</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Ambien/Special K (Ketamine)</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Over the Counter</label></li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Other
                                </label>
                                <input type="text" class="form-control mt-2" placeholder="Specify Other">
                            </li>
                            <li><button class="btn btn-primary mt-2 w-100">OK</button></li>
                        </ul>
                    </div>
                </div>
            </div>


            <!-- Approximate Date of Last Use -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 col-form-label required">Approximate Date of Last Use</label>
                <div class="col-sm-6">
                    <input type="date" class="form-control" value="2025-03-03">
                </div>
            </div>

            <!-- Treatment Status -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 col-form-label required">Treatment Status</label>
                <div class="col-sm-6">
                    <div class="dropdown w-100">
                        <button class="btn btn-white w-100 dropdown-toggle" type="button" id="treatmentDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; text-align: left;">
                            Select Treatment Status
                        </button>
                        <ul class="dropdown-menu w-100 dropdown-menu-end">
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Received treatment in the past</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Presently receiving</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Not receiving treatment</label></li>
                            <li><button class="btn btn-primary mt-2 w-100">OK</button></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Recovery Status -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 col-form-label required">Recovery Status</label>
                <div class="col-sm-6">
                    <div class="dropdown w-100">
                        <button class="btn btn-white w-100 dropdown-toggle" type="button" id="recoveryDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; text-align: left;">
                            Select Recovery Status
                        </button>
                        <ul class="dropdown-menu w-100 dropdown-menu-end">
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Presently Using</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Clean &lt; 3 months</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> Clean &gt; 3 months</label></li>
                            <li><label class="form-check-label d-block"><input type="checkbox" class="form-check-input"> In Treatment</label></li>
                            <li>
                                <label class="form-check-label d-block">
                                    <input type="checkbox" class="form-check-input"> Other
                                </label>
                                <input type="text" class="form-control mt-2" placeholder="Specify Other">
                            </li>
                            <li><button class="btn btn-primary mt-2 w-100">OK</button></li>
                        </ul>
                    </div>
                </div>
            </div>


            <!-- Comments -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 col-form-label">Comments</label>
                <div class="col-sm-6 d-flex">
                    <textarea class="form-control" placeholder="Enter comments" rows="3"></textarea>
                    <button class="btn btn-outline-secondary ms-2">
                        <i class="fas fa-edit text-primary"></i> <!-- Edit Icon -->
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-danger">Delete</button>
                <button type="button" class="btn btn-secondary">Print</button>
                <button type="button" class="btn btn-dark">Exit</button>
            </div>
        </form>
    </div>
</div>
