<script>
    // Ensure the document is fully loaded before running this script
    document.addEventListener("DOMContentLoaded", function () {
        const nextButton = document.getElementById('nextButton'); // Get the Next button
        const familyMemberSection = document.getElementById('familyMemberSection'); // Get the next section
        const intakeForm = document.getElementById('intakeForm'); // Get the current form

        if (nextButton) {
            nextButton.addEventListener('click', function (e) {
                e.preventDefault(); // Prevent form submission for now

                // Hide the current form
                intakeForm.style.display = 'none';

                // Show the family member section
                if (familyMemberSection) {
                    familyMemberSection.style.display = 'block';
                } else {
                    console.log('Family Member section not found.');
                }
            });
        }
    });
</script>
