@page
@model TURN.Pages.HouseholdDisabilityModel
@{
    Layout = "_LayoutLatest";
}

<div style="margin-bottom: 120px;"></div>
@await Html.PartialAsync("Shared/_IntakeGeneralDetails")
<div id="HouseholdDisabilitySection">
    <div class="container mt-8 form-container">
        <h2 class="highlight-header mt-4">Household Disability</h2>

        <h2>Household Disability Information  <button class="btn btn-primary float-end" id="addDisabilityBtn">+</button></h2>
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th>Family Member</th>
                    <th>Disability</th>
                    <th>Status</th>
                   
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Name</td>
                    <td>Disability Type</td>
                    <td>Active</td>
                   
                    <td>
                        <button class="btn btn-sm btn-warning">
                            Edit
                            <i class="fas fa-edit"></i>
                        </button>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-danger">
                            Delete
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
                <!-- Add more rows dynamically as needed -->
            </tbody>
        </table>

        <div id="formDisabilitySection" style="display: none;">
            <form action="/api/HouseholdDisability/SubmitForm" method="post">
                <h4 class="mb-4 mt-5">Add New Household Disability</h4>

                <div class="container">
                    <!-- Family Member Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="familyMember" class="col-sm-4 col-form-label required">Family Member</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle" type="button" id="FamilyMemberDisabilityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                                  @*   Select Family Member *@
                                    John Doe
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li><a class="dropdown-item" href="#">John Doe</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Disability Type Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="disability" class="col-sm-4 col-form-label required">Disability</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle dropdown-toggle-split" type="button" id="DisabilityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: right;">
                                    @* Select Disability Type *@
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li><a class="dropdown-item" href="#">Physical Disability</a></li>
                                    <li><a class="dropdown-item" href="#">Developmental Disability</a></li>
                                    <li><a class="dropdown-item" href="#">Chronic Health Condition</a></li>
                                    <li><a class="dropdown-item" href="#">HIV/AIDS</a></li>
                                    <li><a class="dropdown-item" href="#">Mental Health Disorder</a></li>
                                    <li><a class="dropdown-item" href="#">Substance Use Disorder</a></li>
                                    <li><a class="dropdown-item" href="#">Other</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>



                    <!-- Status Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="status" class="col-sm-4 col-form-label required">Status</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle dropdown-toggle-split" type="button" id="StatusDisabilityDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: right;">
                                    @* Select Status *@
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li><a class="dropdown-item" href="#">Yes</a></li>
                                    <li><a class="dropdown-item" href="#">No</a></li>
                                    <li><a class="dropdown-item" href="#">Don't know</a></li>
                                    <li><a class="dropdown-item" href="#">Client prefers not to answer</a></li>
                                    <li><a class="dropdown-item" href="#">Alcohol Abuse</a></li>
                                    <li><a class="dropdown-item" href="#">Drug Abuse</a></li>
                                    <li><a class="dropdown-item" href="#">Both</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>



                    <!-- Expected Duration Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="duration" class="col-sm-4 col-form-label required">Expected to be of long-continued and indefinite duration and substantially impairs ability to live independently</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle dropdown-toggle-split" type="button" id="DurationDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: right;">
                                   
                                    <span id="dropdownButtonText" class="dropdown-text"> Select Expected to be of long-continued disability</span>
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li><a class="dropdown-item" href="#">Yes</a></li>
                                    <li><a class="dropdown-item" href="#">No</a></li>
                                    <li><a class="dropdown-item" href="#">Client doesn't know</a></li>
                                    <li><a class="dropdown-item" href="#">Client prefers not to answer</a></li>
                                    <li><a class="dropdown-item" href="#">Data not collected</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>


                    <!-- Receiving Services/Treatment Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="receivingServices" class="col-sm-4 col-form-label required">Currently receiving services/ treatment for this condition</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle" type="button" id="ServicesDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                                   
                                    <span id="dropdownButtonText" class="dropdown-text"> Select Currently receiving services/ treatment</span>
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li><a class="dropdown-item" href="#">Yes</a></li>
                                    <li><a class="dropdown-item" href="#">No</a></li>
                                    <li><a class="dropdown-item" href="#">Client doesn't know</a></li>
                                    <li><a class="dropdown-item" href="#">Client prefers not to answer</a></li>
                                    <li><a class="dropdown-item" href="#">Data not collected</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Documentation on file Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="documentationOnFile" class="col-sm-4 col-form-label required">Documentation on file</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle dropdown-toggle-split" type="button" id="DocumentationDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: right;">
                                  @*   Select Option *@
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li><a class="dropdown-item" href="#">Yes</a></li>
                                    <li><a class="dropdown-item" href="#">No</a></li>
                                    <li><a class="dropdown-item" href="#">Client doesn't know</a></li>
                                    <li><a class="dropdown-item" href="#">Client prefers not to answer</a></li>
                                    <li><a class="dropdown-item" href="#">Data not collected</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>


                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between mt-3">
                        <button class="btn btn-secondary" type="button">
                            <i class="fa-solid fa-arrow-left"></i> Go Back
                        </button>
                        <button type="button" class="btn btn-primary" id="nextButton" data-bs-toggle="modal" data-bs-target="#summaryModal">
                            <i class="fa-solid fa-arrow-right"></i> Save
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Show form when + button is clicked
    document.getElementById('addDisabilityBtn').addEventListener('click', function () {
        document.getElementById('formDisabilitySection').style.display = 'block';
    });

    // Handle form submission on Save button click
    function handleSaveDisability() {
        alert('Household Disability Added!');
        document.getElementById('formDisabilitySection').style.display = 'none';
    }
</script>

