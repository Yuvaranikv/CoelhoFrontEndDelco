@page
@model TURN.Pages.HouseHoldBenefitsModel
@{
    Layout = "_LayoutLatest";
}

<div style="margin-bottom: 120px;"></div>
@await Html.PartialAsync("Shared/_IntakeGeneralDetails")
<div id="HouseHoldSection">
    
    <div class="container mt-8 form-container">
        <h2 class="highlight-header mt-4">HouseHold Benefits </h2>

        <h2>HouseHold Benefits  Information  <button class="btn btn-primary float-end" id="addMemberBtn">+</button></h2>
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th>Family Member</th>
                    <th>Noncash Benefits</th>
                    <th>Status</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Name</td>
                    <td>Food Assistance</td>
                    <td>Active</td>
                    <td>
                        <button class="btn btn-sm btn-warning">Edit
                            <i class="fas fa-edit"></i>
                        </button>
                    </td>
                    <td><button class="btn btn-sm btn-danger">Delete
                        <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
                <!-- Add more rows dynamically as needed -->
            </tbody>
        </table>

        <div id="formSection"  style="display: none;">
            

            <form action="/api/IntakeHouseHoldBenefits/SubmitForm" method="post">
                <h4 class="mb-4 mt-5">Add New Household Benefit</h4>

				<div class="container">

                    <!-- Family Member Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="familyMember" class="col-sm-4 col-form-label required">Family Member</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle" type="button" id="FamilyMemberDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                                    Select Family Member
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> John Doe
                                        </label>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>


                    <!-- Noncash Benefits Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="nonCashBenefits" class="col-sm-4 col-form-label required">Noncash Benefits<span class="text-danger">*</span></label>
                        <div class="col-sm-6 d-flex align-items-center position-relative gap-2">
                            <div class="w-100">
                                <button class="btn btn-white w-100 dropdown-toggle" type="button" id="NonCashBenefitsDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                                    Select Noncash Benefit
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Supplemental Nutrition Assistance Program (SNAP)
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Special Supplemental Nutrition Program (WIC)
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> TANF Child Care services
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> TANF Transportation services
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Other TANF - funded services
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Section 8, public housing, or other ongoing rental assistance
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Temporary Rental Assistance
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Other Source
                                        </label>
                                    </li>
                                   
                                </ul>
                            </div>
                            <button class="ellipsis-icon-btn" type="button" data-bs-toggle="modal" data-bs-target="#NonCashBenefitsModal">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Status Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="status" class="col-sm-4 col-form-label required">Status</label>
                        <div class="col-sm-6">
                            <div class="dropdown w-100">
                                <button class="btn btn-white w-100 dropdown-toggle" type="button" id="StatusDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: white; border: 1px solid #ced4da; padding-left: 4px; text-align: left;">
                                    Select Status
                                </button>

                                <ul class="dropdown-menu w-100 dropdown-menu-end" style="list-style: none; padding: 10px; position: absolute; top: 100%; left: 0; z-index: 1050;">
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Currently Receiving
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Applied and decision pending
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Applied and client not eligible
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Client did not apply
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> N/A for this client
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> No
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Don't Know
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Client prefers not to answer
                                        </label>
                                    </li>
                                    <li>
                                        <label class="form-check-label d-block">
                                            <input type="checkbox" class="form-check-input"> Data not collected
                                        </label>
                                    </li>
                                  
                                </ul>
                            </div>
                           
                        </div>
                    </div>


                    <!-- Food Stamp Amount Input -->
                    <div class="mb-3 row align-items-center">
                        <label for="foodStampAmount" class="col-sm-4 col-form-label required">Food Stamp Amount</label>
                        <div class="col-sm-6 d-flex align-items-center position-relative gap-2">
                            <input type="number" id="foodStampAmount" class="form-control" placeholder="Enter Amount">
                           
                        </div>
                    </div>


            <!-- Action Buttons -->
                    <div class="d-flex justify-content-between mt-3">
                        <button class="btn btn-secondary" type="button">
                            <i class="fa-solid fa-arrow-left"></i> Go Back
                        </button>
                        <button type="button" class="btn btn-primary" id="nextButton" data-bs-toggle="modal" data-bs-target="#summaryModal">
                            <i class="fa-solid fa-arrow-right"></i> Save
                        </button>
                    </div>
        </div>
        </form>
    </div>
</div>
</div>
<script>
    // Show form when + button is clicked
    document.getElementById('addMemberBtn').addEventListener('click', function () {
        document.getElementById('formSection').style.display = 'block';
    });

    // Hide form when Cancel button is clicked
    document.getElementById('cancelButton').addEventListener('click', function () {
        document.getElementById('formSection').style.display = 'none';
    });

    // Handle form submission on OK button click
    document.getElementById('okButton').addEventListener('click', function () {
        alert('Household Benefit Added!');
        document.getElementById('formSection').style.display = 'none';
    });
</script>